# ============================================================
# .gitignore — gas-badminton-scheduler
# ============================================================
# このファイルは「Git(バージョン管理ツール)で記録したくないファイル」を
# 列挙するものです。ここに書いたファイルは git に上がらなくなります。
# 「なぜ除外するか」をコメントで併記しています。
# ============================================================


# ------------------------------------------------------------
# Node.js / npm 関連
# ------------------------------------------------------------

# node_modules はライブラリ本体(数万ファイル)が入る巨大フォルダ。
# package.json があれば誰でも `npm install` で復元できるので、
# Git に上げない(=リポジトリが軽くなる + 環境差を吸収)。
node_modules/

# npm のキャッシュ・ログ。トラブル時しか使わない一時ファイル。
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/


# ------------------------------------------------------------
# clasp(GAS のローカル開発ツール)関連
# ------------------------------------------------------------

# .clasp.json は「どの GAS プロジェクトに紐づいているか」を示す設定ファイル。
# スクリプト ID(=プロジェクトの場所)が含まれていて、
# 公開リポジトリに上がると他人が触れる可能性があるため除外。
# (個人開発でローカルで使うだけなら手元には残る)
.clasp.json

# clasp のログイン情報(認証トークン)。絶対に Git に上げない。
.clasprc.json


# ------------------------------------------------------------
# 環境変数・秘密情報
# ------------------------------------------------------------

# .env はパスワード・API キー・LINE のチャネルアクセストークンなど
# 「他人に知られたら困る情報」を入れるファイル。絶対に Git に上げない。
.env
.env.local
.env.*.local

# 認証情報ファイル(Channel secret / access token / Spreadsheet ID 等が含まれる)
必要情報.txt


# ------------------------------------------------------------
# ログファイル
# ------------------------------------------------------------

# プログラム実行時に出る記録ファイル。一時的なもの。
*.log
logs/


# ------------------------------------------------------------
# OS 固有の自動生成ファイル
# ------------------------------------------------------------

# Windows がフォルダのサムネイルキャッシュを作るファイル
Thumbs.db
ehthumbs.db
Desktop.ini

# macOS がフォルダ情報を保存するファイル(Mac 利用者がいた場合のため)
.DS_Store
.AppleDouble
.LSOverride


# ------------------------------------------------------------
# エディタ・IDE 関連
# ------------------------------------------------------------

# VS Code のワークスペース設定(個人差があるので共有しない)
.vscode/
*.code-workspace

# JetBrains 系(IntelliJ、WebStorm など)の設定フォルダ
.idea/

# Vim の一時ファイル
*.swp
*.swo
*~


# ------------------------------------------------------------
# ビルド・テストの一時出力
# ------------------------------------------------------------

# テストカバレッジレポートなど(将来テスト導入時のため先に書いておく)
coverage/
.nyc_output/
dist/
build/
